generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CAJERO
  MESERO
  BARTENDER
}

enum EstadoMesa {
  DISPONIBLE
  OCUPADA
  RESERVADA
  MANTENIMIENTO
}

enum EstadoBolirana {
  DISPONIBLE
  EN_USO
  MANTENIMIENTO
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  NEQUI
  DAVIPLATA
  TRANSFERENCIA
}

enum EstadoVenta {
  ABIERTA
  PAGADA
  CANCELADA
  DIVIDIDA
}

enum EstadoCompra {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

model User {
  id        String   @id @default(uuid())
  authId    String   @unique
  email     String   @unique
  nombre    String
  role      Role     @default(MESERO)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  ventas              Venta[]
  movimientosInventario MovimientoInventario[]
  movimientosCaja     MovimientoCaja[]
  cierresCaja         CierreCaja[]
  aperturasCaja       AperturaCaja[]
  compras             Compra[]
  auditorias          Auditoria[]

  @@map("users")
}

model Mesa {
  id         String     @id @default(uuid())
  numero     Int        @unique
  nombre     String?
  capacidad  Int        @default(4)
  estado     EstadoMesa @default(DISPONIBLE)
  zona       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  ventas Venta[]

  @@map("mesas")
}

model Bolirana {
  id            String         @id @default(uuid())
  numero        Int            @unique
  nombre        String?
  estado        EstadoBolirana @default(DISPONIBLE)
  precioPorHora Decimal        @default(0) @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  ventas   Venta[]
  sesiones SesionBolirana[]

  @@map("boliranas")
}

model Categoria {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  color       String   @default("#6366f1")
  icono       String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productos Producto[]

  @@map("categorias")
}

model Producto {
  id          String    @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Decimal   @db.Decimal(10, 2)
  costo       Decimal   @default(0) @db.Decimal(10, 2)
  categoriaId String
  stock       Decimal   @default(0) @db.Decimal(10, 3)
  stockMinimo Decimal   @default(0) @db.Decimal(10, 3)
  unidad      String    @default("und")
  imagen      String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  categoria             Categoria              @relation(fields: [categoriaId], references: [id])
  detallesVenta         DetalleVenta[]
  movimientosInventario MovimientoInventario[]
  detallesCompra        DetalleCompra[]

  @@map("productos")
}

model Venta {
  id          String      @id @default(uuid())
  numero      String      @unique
  mesaId      String?
  boliranaId  String?
  userId      String
  subtotal    Decimal     @default(0) @db.Decimal(10, 2)
  descuento   Decimal     @default(0) @db.Decimal(10, 2)
  propina     Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @default(0) @db.Decimal(10, 2)
  metodoPago  MetodoPago  @default(EFECTIVO)
  estado      EstadoVenta @default(ABIERTA)
  observacion String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  mesa      Mesa?     @relation(fields: [mesaId], references: [id])
  bolirana  Bolirana? @relation(fields: [boliranaId], references: [id])
  usuario   User      @relation(fields: [userId], references: [id])
  detalles  DetalleVenta[]
  sesionBolirana SesionBolirana?

  @@map("ventas")
}

model DetalleVenta {
  id             String  @id @default(uuid())
  ventaId        String
  productoId     String
  cantidad       Decimal @db.Decimal(10, 3)
  precioUnitario Decimal @db.Decimal(10, 2)
  descuento      Decimal @default(0) @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("detalles_venta")
}

model SesionBolirana {
  id         String    @id @default(uuid())
  boliranaId String
  ventaId    String    @unique
  inicio     DateTime
  fin        DateTime?
  duracion   Int?
  costo      Decimal   @default(0) @db.Decimal(10, 2)
  createdAt  DateTime  @default(now())

  bolirana Bolirana @relation(fields: [boliranaId], references: [id])
  venta    Venta    @relation(fields: [ventaId], references: [id])

  @@map("sesiones_bolirana")
}

model MovimientoInventario {
  id         String                   @id @default(uuid())
  productoId String
  tipo       TipoMovimientoInventario
  cantidad   Decimal                  @db.Decimal(10, 3)
  motivo     String?
  referencia String?
  userId     String
  createdAt  DateTime                 @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
  usuario  User     @relation(fields: [userId], references: [id])

  @@map("movimientos_inventario")
}

model Proveedor {
  id        String    @id @default(uuid())
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  nit       String?
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  compras Compra[]

  @@map("proveedores")
}

model Compra {
  id          String       @id @default(uuid())
  proveedorId String
  userId      String
  total       Decimal      @db.Decimal(10, 2)
  estado      EstadoCompra @default(PENDIENTE)
  observacion String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  proveedor Proveedor      @relation(fields: [proveedorId], references: [id])
  usuario   User           @relation(fields: [userId], references: [id])
  detalles  DetalleCompra[]

  @@map("compras")
}

model DetalleCompra {
  id             String  @id @default(uuid())
  compraId       String
  productoId     String
  cantidad       Decimal @db.Decimal(10, 3)
  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  compra   Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("detalles_compra")
}

model MovimientoCaja {
  id         String             @id @default(uuid())
  tipo       TipoMovimientoCaja
  concepto   String
  monto      Decimal            @db.Decimal(10, 2)
  referencia String?
  userId     String
  createdAt  DateTime           @default(now())

  usuario User @relation(fields: [userId], references: [id])

  @@map("movimientos_caja")
}

model CierreCaja {
  id             String   @id @default(uuid())
  userId         String
  totalIngresos  Decimal  @db.Decimal(10, 2)
  totalEgresos   Decimal  @db.Decimal(10, 2)
  saldoInicial   Decimal  @default(0) @db.Decimal(10, 2)
  saldoFinal     Decimal  @db.Decimal(10, 2)
  observaciones  String?
  createdAt      DateTime @default(now())

  usuario User @relation(fields: [userId], references: [id])

  @@map("cierres_caja")
}

model AperturaCaja {
  id        String   @id @default(uuid())
  userId    String
  saldoBase Decimal  @default(0) @db.Decimal(10, 2)
  estado    String   @default("ABIERTA")
  cierreId  String?
  createdAt DateTime @default(now())
  closedAt  DateTime?

  usuario User @relation(fields: [userId], references: [id])

  @@map("aperturas_caja")
}

model Empleado {
  id        String   @id @default(uuid())
  nombre    String
  cargo     String?
  jornal    Decimal  @default(0) @db.Decimal(10, 2)
  activo    Boolean  @default(true)
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagos PagoNomina[]

  @@map("empleados")
}

model PagoNomina {
  id               String   @id @default(uuid())
  empleadoId       String
  monto            Decimal  @db.Decimal(10, 2)
  concepto         String?
  fecha            DateTime @db.Date
  metodoPago       String   @default("EFECTIVO")
  registradoPor    String?
  cajaMovimientoId String?
  createdAt        DateTime @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@map("pagos_nomina")
}

model Auditoria {
  id         String   @id @default(uuid())
  userId     String?
  accion     String
  entidad    String
  entidadId  String?
  detalles   Json?
  ip         String?
  createdAt  DateTime @default(now())

  usuario User? @relation(fields: [userId], references: [id])

  @@map("auditoria")
}
